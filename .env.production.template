# 本番環境用環境変数テンプレート
# このファイルをコピーして .env.production を作成してください
# ⚠️ .env.production は .gitignore に追加すること！

# ========================================
# データベース設定
# ========================================
FIRESTORE_PROJECT_ID=your-project-id-here

# ========================================
# LINE Bot設定（新しい認証情報を使用）
# ========================================
LINE_CHANNEL_ACCESS_TOKEN=your-new-line-channel-access-token
LINE_CHANNEL_SECRET=your-new-line-channel-secret

# ========================================
# JWT設定
# ========================================
# 以下のコマンドで生成できます:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your-secure-random-jwt-secret-here

# ========================================
# アプリケーション設定
# ========================================
ENVIRONMENT=production
PORT=8080
LOG_LEVEL=info

# ========================================
# CORS設定
# ========================================
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ========================================
# AWS設定（オプション）
# ========================================
AWS_REGION=ap-northeast-1
AWS_ACCOUNT_ID=your-aws-account-id

# ========================================
# セキュリティ設定
# ========================================
# セッションの有効期限（秒）
SESSION_TIMEOUT=3600

# レート制限（リクエスト/分）
RATE_LIMIT=100

# ========================================
# 監視・ログ設定
# ========================================
ENABLE_METRICS=true
ENABLE_TRACING=true
LOG_FORMAT=json

# ========================================
# 機能フラグ
# ========================================
ENABLE_MAINTENANCE_MODE=false
ENABLE_DEBUG_MODE=false
